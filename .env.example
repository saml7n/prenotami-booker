# Prenotami Booker Environment Variables
# Copy this to .env and fill in your details.
# Environment variables override config.yaml values.

# Prenot@mi credentials
PRENOTAMI_EMAIL=your-email@example.com
PRENOTAMI_PASSWORD=your-prenotami-password

# IMAP settings for OTP retrieval
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_EMAIL=your-email@example.com
IMAP_PASSWORD=your-email-app-password

# SMTP settings for notifications (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@example.com
SMTP_PASSWORD=your-email-app-password
NOTIFY_EMAIL=your-email@example.com
